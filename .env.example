# ════════════════════════════════════════════════════════════════
#  ArcticLoom — Environment Template
#  Copy this file to `.env` and fill in your real keys.
#  `.env` is git-ignored and must NEVER be committed.
# ════════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────
PORT=3002

# ── RAG Pipeline ────────────────────────────────────────────────
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5

# Accuracy gate: an answer is only generated if the best matching chunk
# is at least this similar (cosine) to the query. Lower = more willing to answer.
MIN_RELEVANCE_SCORE=0.30

# LLM sampling
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0.2

# Upload staging dir (optional). Defaults to the OS temp directory.
# Files are ALWAYS deleted immediately after ingestion - nothing persists.
# UPLOAD_DIR=

# ── Weaviate Cloud (vector database) ────────────────────────────
# Create a free sandbox at https://weaviate.io/developers/wcs
WEAVIATE_URL=https://YOUR-INSTANCE.weaviate.cloud
WEAVIATE_API_KEY=YOUR-WEAVIATE-API-KEY

# ── Hugging Face (LLM inference) ────────────────────────────────
# Create a token at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_YOUR_HF_TOKEN